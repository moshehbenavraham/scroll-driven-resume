# Modern Resume Site - Environment Variables
# Copy this file to .env and customize values
# NEVER commit .env to version control

# =============================================================================
# AI Services
# =============================================================================

# Gemini API Key for video generation
# Get your API key from: https://ai.google.dev/aistudio
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: You can also use GOOGLE_API_KEY
# GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# MinIO Configuration (S3-compatible object storage)
# =============================================================================

# MinIO admin credentials (minimum 8 characters each)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# MinIO ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# PostgreSQL Configuration
# =============================================================================

# Database credentials
POSTGRES_USER=resume_admin
POSTGRES_PASSWORD=resume_secret_123
POSTGRES_DB=resume_metadata

# PostgreSQL port (use 5435+ if lower ports are occupied)
POSTGRES_PORT=5435

# =============================================================================
# Nginx Configuration
# =============================================================================

# Nginx reverse proxy port (8080 avoids privileged port 80)
NGINX_PORT=8080

# =============================================================================
# Application Configuration
# =============================================================================

# Next.js dev server URL (for CORS configuration)
NEXTJS_DEV_URL=http://localhost:3000

# Cache duration for static assets (7 days in seconds)
CACHE_MAX_AGE=604800

# =============================================================================
# Next.js Public Environment Variables
# =============================================================================

# Asset delivery base URL (MinIO direct or via Nginx cache)
# For development: http://localhost:9000/resume-assets
# For production: https://cdn.yourdomain.com/resume-assets
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:9000/resume-assets
